{
  "version": 2,
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "framework": "vite",
  "env": {
    "DATABASE_URL": {
      "description": "MySQL/TiDB connection string"
    },
    "JWT_SECRET": {
      "description": "Session cookie signing secret"
    },
    "VITE_APP_ID": {
      "description": "Manus OAuth application ID"
    },
    "OAUTH_SERVER_URL": {
      "description": "Manus OAuth backend base URL"
    },
    "VITE_OAUTH_PORTAL_URL": {
      "description": "Manus login portal URL"
    },
    "OWNER_OPEN_ID": {
      "description": "Owner's OpenID"
    },
    "OWNER_NAME": {
      "description": "Owner's name"
    },
    "BUILT_IN_FORGE_API_URL": {
      "description": "Manus built-in APIs URL"
    },
    "BUILT_IN_FORGE_API_KEY": {
      "description": "Manus built-in APIs key"
    },
    "VITE_FRONTEND_FORGE_API_URL": {
      "description": "Frontend Forge API URL"
    },
    "VITE_FRONTEND_FORGE_API_KEY": {
      "description": "Frontend Forge API key"
    },
    "TELEGRAM_BOT_TOKEN": {
      "description": "Telegram bot token"
    },
    "VITE_APP_TITLE": {
      "description": "Application title"
    },
    "VITE_APP_LOGO": {
      "description": "Application logo URL"
    }
  },
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
